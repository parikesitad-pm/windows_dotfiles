# DOTMOD Profile: Common Shell Environment
# Shared across all developer profiles

# --- Git Shortcuts ---
alias gs="git status"
alias ga="git add"
alias gaa="git add ."
alias gc="git commit -m"
alias gp="git push"
alias gpl="git pull"
alias gl="git log --oneline --graph --decorate"

# --- Navigation & Utilities ---
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias ll="ls -lah"
alias la="ls -A"
alias l="ls -CF"
alias cls="clear"

# Safety confirmations
alias rm="rm -i"
alias cp="cp -i"
alias mv="mv -i"
