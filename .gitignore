# ============================================================
# DOTMOD — .gitignore
# Security and exclusion rules for Windows dotfiles repository
# ============================================================

# Environment and secrets
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.token
credentials*
secret*
secrets*
*password*
*api_key*
*apikey*

# SSH private material
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_ecdsa
id_ecdsa.pub
known_hosts
authorized_keys

# Browser data and authentication
cookies*
history*
Login Data*
Web Data*
Sessions/
sessionstore*
*.sqlite
key4.db
logins.json
formhistory.sqlite

# System and editor caches
Cache/
CachedData/
GPUCache/
workspaceStorage/
globalStorage/
History/
.cache/
.vscode-shared/

# Temporary and log files
logs/
*.log
tmp/
temp/
*.tmp
*.bak

# Safety restoration backups
*.pre-dotmod
*.pre-dotmod.*

# DOTMOD local restore state
.dotmod/
.dotmod/*

# Node and build targets
node_modules/
target/
dist/
build/

# OS metadata
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
